{
  "manifest_version": 3,
  "name": "NoPorno",
  "version": "2.0.0",
  "description": "Calm, supportive adult-site blocker with redirection and habit-safe alternatives.",
  "incognito": "split",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "badsites.js",
      "bad-keywords.js",
      "reddits.js",
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NoPorno"
  },
  "options_page": "settings.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-url-observer.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "redirect.html",
        "redirect.css",
        "redirect.js",
        "goodsites.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "noporno@toliver.hu",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "creative/icon16.png",
    "48": "creative/icon48.png",
    "128": "creative/icon128.png"
  }
}